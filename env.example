# =============================================================================
# Backend Configuration - Chatbot Tư vấn Tuyển sinh HUCE
# =============================================================================
# Copy file này thành .env và điều chỉnh các giá trị theo môi trường của bạn

# -----------------------------------------------------------------------------
# NLP Configuration
# -----------------------------------------------------------------------------
# Ngưỡng confidence cho intent detection (0.0 - 1.0)
INTENT_THRESHOLD=0.35

# -----------------------------------------------------------------------------
# NLU Model Artifacts (local filesystem)
# -----------------------------------------------------------------------------
# Thư mục chứa model intent (canonical). Alias tương thích cũ: INTENT_MODEL_PATH
NLU_INTENT_MODEL_DIR=
# INTENT_MODEL_PATH=

# Thư mục chứa model NER (canonical). Alias tương thích cũ: NER_MODEL_PATH
NLU_NER_MODEL_DIR=
# NER_MODEL_PATH=

# -----------------------------------------------------------------------------
# NLU Runtime
# -----------------------------------------------------------------------------
# Thiết bị inference: cpu | cuda (để trống = tự động chọn)
NLU_DEVICE=

# Bật/tắt autocast (true/false). Mặc định: bật khi có CUDA, tắt khi CPU
NLU_AUTOCAST=true

# Giới hạn số ký tự tối đa cho intent input (sau context). 0 = tắt giới hạn thêm
NLU_INTENT_MAX_CHARS=0

# Nếu > 0 và message dài hơn: bỏ qua NER model (chỉ pattern/dictionary). 0 = tắt
NLU_NER_MAX_CHARS=0

# Intent engine: legacy | transformer. Entity: deterministic | transformer | off
NLU_INTENT_ENGINE=legacy
NLU_ENTITY_ENGINE=deterministic

# Ngân sách inference (ms). Tên canonical (ưu tiên): NLU_*_BUDGET_MS
# Alias tương thích cũ: INTENT_INFERENCE_BUDGET_MS / ENTITY_INFERENCE_BUDGET_MS
NLU_INTENT_BUDGET_MS=400
NLU_ENTITY_BUDGET_MS=400

# Giới hạn số câu lưu trong context
CONTEXT_HISTORY_LIMIT=10

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host và port cho server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Debug mode (true/false)
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Danh sách origins được phép (ngăn cách bởi dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Cho phép credentials
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Data Configuration
# -----------------------------------------------------------------------------
# Đường dẫn thư mục chứa dữ liệu CSV (relative to backend folder)
# DATA_DIR=./data

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Bật/tắt CSV caching
ENABLE_CSV_CACHE=true

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Số kết quả tối đa trả về
MAX_RESULTS=100

# Số gợi ý ngành tối đa
MAX_SUGGESTIONS=20

