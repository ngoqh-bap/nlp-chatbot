# =============================================================================
# Backend Configuration - Chatbot Tư vấn Tuyển sinh HUCE
# =============================================================================
# Copy file này thành .env và điều chỉnh các giá trị theo môi trường của bạn

# -----------------------------------------------------------------------------
# NLP Configuration
# -----------------------------------------------------------------------------
# Ngưỡng confidence cho intent detection (0.0 - 1.0)
INTENT_THRESHOLD=0.35

# -----------------------------------------------------------------------------
# NLU Model Artifacts (local filesystem)
# -----------------------------------------------------------------------------
# Thư mục chứa model intent (canonical). Alias tương thích cũ: INTENT_MODEL_PATH
# Sau fine-tune (scripts/train_intent_phobert.py --out ...), trỏ biến này vào thư mục đã save.
NLU_INTENT_MODEL_DIR=
# INTENT_MODEL_PATH=

# Thư mục chứa model NER (canonical). Alias tương thích cũ: NER_MODEL_PATH
# Path A — community PhoBERT NER: tải checkpoint TokenClassification từ Hugging Face,
#   save_pretrained vào thư mục cục bộ rồi trỏ biến này vào đó.
# Path B — fine-tune: chạy scripts/train_ner_phobert.py --out ... rồi trỏ vào thư mục đã save.
# Bật NLU_ENTITY_ENGINE=transformer để dùng model; deterministic vẫn chạy và merge.
NLU_NER_MODEL_DIR=
# NER_MODEL_PATH=

# -----------------------------------------------------------------------------
# NLU Runtime
# -----------------------------------------------------------------------------
# Thiết bị inference: cpu | cuda (để trống = tự động chọn)
NLU_DEVICE=

# Bật/tắt autocast (true/false). Mặc định: bật khi có CUDA, tắt khi CPU
NLU_AUTOCAST=true

# Giới hạn số ký tự tối đa cho intent input (sau context). 0 = tắt giới hạn thêm
NLU_INTENT_MAX_CHARS=0

# Nếu > 0 và message dài hơn: bỏ qua NER model (chỉ pattern/dictionary). 0 = tắt
NLU_NER_MAX_CHARS=0

# Intent engine: legacy | transformer. Entity: deterministic | transformer | off
NLU_INTENT_ENGINE=legacy
NLU_ENTITY_ENGINE=deterministic

# Ngân sách inference (ms). Tên canonical (ưu tiên): NLU_*_BUDGET_MS
# Alias tương thích cũ: INTENT_INFERENCE_BUDGET_MS / ENTITY_INFERENCE_BUDGET_MS
NLU_INTENT_BUDGET_MS=400
NLU_ENTITY_BUDGET_MS=400

# Giới hạn số câu lưu trong context
CONTEXT_HISTORY_LIMIT=10

# Hugging Face Hub (optional: higher rate limits when downloading models during training)
# https://huggingface.co/settings/tokens — train script loads .env before calling the Hub
HF_TOKEN=

# -----------------------------------------------------------------------------
# Intent training — scripts/train_intent_phobert.py (NVIDIA GPU)
# -----------------------------------------------------------------------------
# Windows/Linux: pyproject.toml resolves `torch` from CUDA 12.8 (cu128), including RTX 50 / sm_120.
# After cloning or changing deps: `uv lock` then `uv sync`, then `uv run python scripts/...`.
# macOS: PyPI `torch` (MPS/CPU), not NVIDIA CUDA.
#
# TRAIN_DEVICE: auto | cuda | cpu  (auto uses CUDA if available)
# TRAIN_AMP: auto | bf16 | fp16 | none  (auto: bf16 if supported else fp16+GradScaler)
# TRAIN_NUM_WORKERS: DataLoader workers (Windows: 0–2 often OK; Linux: 4–8 typical)
# CUDA_VISIBLE_DEVICES=0  # chỉ định GPU (optional, set outside .env or here)
TRAIN_DEVICE=auto
TRAIN_AMP=auto
TRAIN_BATCH_SIZE=16
TRAIN_GRAD_ACCUM=1
TRAIN_NUM_WORKERS=4
TRAIN_SEED=42
TRAIN_EPOCHS=5
TRAIN_LR=2e-5
TRAIN_MAX_LEN=128
TRAIN_WARMUP_RATIO=0.06
TRAIN_MAX_GRAD_NORM=1.0
# TRAIN_DATA=data/intent.csv
# TRAIN_BASE_MODEL=vinai/phobert-base

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host và port cho server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Debug mode (true/false)
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Danh sách origins được phép (ngăn cách bởi dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Cho phép credentials
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Data Configuration
# -----------------------------------------------------------------------------
# Đường dẫn thư mục chứa dữ liệu CSV (relative to backend folder)
# DATA_DIR=./data

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Bật/tắt CSV caching
ENABLE_CSV_CACHE=true

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Số kết quả tối đa trả về
MAX_RESULTS=100

# Số gợi ý ngành tối đa
MAX_SUGGESTIONS=20

